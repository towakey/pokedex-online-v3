# このファイルをコピーして .env（ローカル開発用）/ .env.production（本番用）を作成する
# 実際の値をコミットしないこと（.gitignore で除外済み）

NUXT_PUBLIC_POKEDEX_API_BASE_URL=http://localhost/pokedex-online-v3/pokedex/api

# 公開サイトのオリジン（パスなし、末尾スラッシュなし）。canonical/OGP/sitemapの生成に使用
# 例: NUXT_PUBLIC_SITE_URL
NUXT_PUBLIC_SITE_URL=https://example.com

# タグ管理システム認証情報（ローカル開発用）
TAGS_ADMIN_USER=admin
TAGS_ADMIN_PASS=change-me

# Twitter Bot: X API (OAuth 1.0a) - developer.x.com の Keys and tokens から取得
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# 商品情報API（Devin Automation からの POST 用トークン）
PRODUCTS_API_TOKEN=
PRODUCTS_ADMIN_USER=admin
PRODUCTS_ADMIN_PASS=change-me

# Twitter Bot 管理ページ認証情報（未設定時は TAGS_ADMIN_* を使用）
TWITTER_ADMIN_USER=
TWITTER_ADMIN_PASS=
