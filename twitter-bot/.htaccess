# ディレクトリリスティング防止
Options -Indexes

# ドットファイル (.env 等) へのアクセス拒否
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# cron実行スクリプト・ライブラリへの直接アクセス拒否
<FilesMatch "^(tweet\.php|.*\.log|.*\.db|.*\.lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
